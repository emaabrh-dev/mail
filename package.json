{
  "name": "mail",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/check-acte.js",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run start-backend\"",
    "dev:frontend": "next dev --turbopack",
    "dev:backend-unix": "./.venv/bin/python -m uvicorn main:app --reload --port 9721",
    "dev:backend-win": ".\\.venv\\Scripts\\python.exe -m uvicorn main:app --reload --port 9721",
    "start-backend": "npm run dev:backend-unix || npm run dev:backend-win",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "generate:acte": "TS_NODE_COMPILER_OPTIONS='{ \"module\": \"CommonJS\" }' ts-node scripts/generate-acte-runtime.ts"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.5",
    "@mui/material": "^7.3.5",
    "axios": "^1.13.2",
    "next": "16.0.1",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.0.1",
    "openapi-fetch": "^0.15.0",
    "openapi-typescript": "^7.10.1",
    "openapi-typescript-codegen": "^0.29.0",
    "orval": "^7.13.2",
    "tailwindcss": "^4",
    "ts-morph": "^27.0.2",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}
